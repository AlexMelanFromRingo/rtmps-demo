# Copy to .env and adjust. Everything has a working default for a local demo.

# ── Secrets (REQUIRED for anything reachable from other machines) ──
# Generate with: openssl rand -hex 32   (use URL-safe characters only)
INTERNAL_SECRET=
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Public URLs shown to streamers (must be reachable from THEIR machines) ──
PUBLIC_RTMP_URL=rtmp://localhost:1935/live
PUBLIC_SRT_URL=srt://localhost:8890
PUBLIC_WHIP_URL=http://localhost:8889
# HLS base for players: same-origin "/hls" or your CDN, e.g. https://cdn.example.com/hls
PUBLIC_HLS_BASE=/hls
# Public IP/hostname(s) of the ingest node for WebRTC ICE (comma-separated)
WEBRTC_PUBLIC_HOSTS=

# ── Web ──
HTTP_PORT=8080
# true when the site is served over HTTPS
COOKIE_SECURE=false

# ── Scale ──
API_REPLICAS=2
WORKER_REPLICAS=2
# concurrent transcodes per worker (a 1080p60 ladder on libx264 ≈ 4 cores)
WORKER_SLOTS=2
# auto | libx264 | h264_nvenc | h264_qsv
ENCODER=auto
X264_PRESET=veryfast
# H.264 rungs (short side) offered below the source resolution
LADDER=1080,720,480,360,160

LOG_LEVEL=info
