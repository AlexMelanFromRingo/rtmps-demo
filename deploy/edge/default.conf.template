# StreamHub edge: SPA + API load balancer + HLS cache in front of object storage.
# Rendered by the nginx image's envsubst (only ${VARS} that exist in the env).
# Scale horizontally; put a CDN in front for internet-scale delivery.

resolver ${DNS_RESOLVER} valid=5s ipv6=off;

upstream api_upstream {
    zone api_upstream 64k;
    server ${API_HOST}:${API_PORT} resolve max_fails=2 fail_timeout=5s;   # re-resolved: picks up scaled replicas
    keepalive 32;
}

upstream s3_upstream {
    zone s3_upstream 64k;
    server ${S3_HOST}:${S3_PORT} resolve;
    keepalive 32;
}

proxy_cache_path /var/cache/nginx/hls levels=1:2 keys_zone=hls:32m max_size=${HLS_CACHE_MAX_SIZE} inactive=5m use_temp_path=off;

limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=sse_per_ip:10m;

server {
    listen 8080;
    server_name _;
    server_tokens off;
    client_max_body_size 64k;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/vnd.apple.mpegurl;

    root /usr/share/nginx/html;

    location = /edge-health { access_log off; default_type text/plain; return 200 "ok\n"; }

    # Never expose internal/ops endpoints of the API.
    location /internal/ { return 404; }
    location ~ ^/(metrics|healthz|readyz)$ { return 404; }

    # ── API (round-robin over replicas; idempotent retries on failure) ──
    location /api/ {
        limit_req zone=api_per_ip burst=60 nodelay;
        limit_req_status 429;
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_read_timeout 30s;
        proxy_next_upstream error timeout http_502 http_503;
        proxy_next_upstream_tries 3;
    }

    # Avatar upload is the only large request body (base64 JSON, ≤ 2 MB image).
    location = /api/channel/avatar {
        client_max_body_size 3m;
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Server-Sent Events (channel state + OBS overlays): unbuffered, long-lived ──
    location ~ ^/api/(channels|overlay)/[^/]+/events$ {
        limit_conn sse_per_ip 20;
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_next_upstream error timeout;
    }

    # ── HLS delivery from object storage, micro-cached ──
    # Playlists: max-age=1 + cache lock → ~1 origin request/s per edge no matter
    # how many viewers. Segments: immutable, cached until evicted.
    location /hls/ {
        limit_except GET HEAD { deny all; }
        proxy_pass http://s3_upstream/${S3_BUCKET}/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host ${S3_HOST}:${S3_PORT};
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header Server;
        proxy_ignore_headers Set-Cookie;

        proxy_cache hls;
        proxy_cache_key $uri;
        proxy_cache_valid 200 206 10s;   # fallback when the object has no Cache-Control
        proxy_cache_valid 403 404 1s;    # a playlist may appear any moment
        proxy_cache_lock on;
        proxy_cache_lock_timeout 3s;
        proxy_cache_lock_age 3s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_revalidate on;

        add_header X-Cache-Status $upstream_cache_status always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Expose-Headers "X-Cache-Status" always;
    }

    # ── User media (avatars): immutable random keys in the same bucket ──
    location /media/ {
        limit_except GET HEAD { deny all; }
        proxy_pass http://s3_upstream/${S3_BUCKET}/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host ${S3_HOST}:${S3_PORT};
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header Server;
        proxy_cache hls;
        proxy_cache_key $uri;
        proxy_cache_valid 200 1h;
        proxy_cache_valid 403 404 10s;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # ── SPA ──
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Permissions-Policy "camera=(self), microphone=(self), display-capture=(self)" always;
    }
}
