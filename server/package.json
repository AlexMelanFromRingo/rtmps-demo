{
  "name": "streamhub-server",
  "version": "2.0.0",
  "private": true,
  "description": "StreamHub backend: API + control plane + transcoding workers",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "api": "node src/api/main.ts",
    "worker": "node src/worker/main.ts",
    "migrate": "node src/migrate.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test 'test/unit/**/*.test.ts'",
    "test:e2e": "node --test --test-concurrency=1 'test/e2e/**/*.test.ts'"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@fastify/cookie": "^11.1.5",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
